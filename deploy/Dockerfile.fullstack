# Deploy mode C — single container: nginx + supervisor + Django (gunicorn).
# Build context = repo root:  docker build -f deploy/Dockerfile.fullstack .

# ── Stage 1: Angular build ────────────────────────────────────────────────────
FROM node:24-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --prefer-offline --no-audit
COPY frontend/ .
# environment.ts already targets apiUrl '/api/v1' (same-origin) for production.
RUN npm run build -- --configuration=production

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
# Python 3.14 — all binary deps ship cp314 wheels (checked 2026-10-02).
FROM python:3.14-slim

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends nginx supervisor curl && \
    rm -rf /var/lib/apt/lists/*

# Non-root runtime user for gunicorn.
RUN groupadd --system appuser && \
    useradd --system --gid appuser --create-home --home-dir /home/appuser appuser

WORKDIR /app

# Install pinned runtime deps from the lockfile (reproducible + scannable).
# pyproject keeps open ranges; requirements.lock pins the resolved versions.
COPY backend/requirements.lock ./
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir -r requirements.lock && \
    # pip is a build-time tool only — Django/gunicorn never import it — and its
    # own wheel vendors an outdated msgpack that Trivy flags regardless of the
    # pip version installed. ensurepip's bundled setuptools wheel is likewise
    # dead weight, never invoked once deps are already installed.
    pip uninstall -y pip && \
    rm -rf /usr/local/lib/python3.14/ensurepip

# Django project source.
COPY backend/ ./
# Angular static output → nginx web root.
COPY --from=frontend-builder /app/dist/MeterFlow/browser /usr/share/nginx/html

# Collect Django admin static (served by WhiteNoise via gunicorn).
ENV DJANGO_SETTINGS_MODULE=config.settings.prod
# Run collectstatic under dev settings with throwaway env so the prod guards
# don't fire and NO secret key persists into the image (security-standards §12;
# a baked, repo-readable key would forge JWT cookies).
RUN DJANGO_SETTINGS_MODULE=config.settings.dev DATABASE_URL=sqlite:///tmp/build.sqlite3 \
    python manage.py collectstatic --noinput

RUN mkdir -p /app/media && chown -R appuser:appuser /app

ENV GUNICORN_WORKERS=3

COPY deploy/nginx.fullstack.conf /etc/nginx/sites-available/default
COPY deploy/supervisord.conf /etc/supervisor/conf.d/meterflow.conf
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
