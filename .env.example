# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=meterflow
POSTGRES_USER=meterflow
POSTGRES_PASSWORD=changeme

# Django (psycopg / sync). Format: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://meterflow:changeme@postgres:5432/meterflow

# ── Django core ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=changeme_use_a_long_random_value
# development | production
DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API (Deploy-Modus A/B, getrennte Origins)
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# ── Auth (JWT in HttpOnly-Cookies) ───────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
# Cookie-Flags: in Produktion Secure=1 erzwingen
AUTH_COOKIE_SECURE=1
AUTH_COOKIE_SAMESITE=Strict

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=80

# ── Storage Backend: local | s3 ──────────────────────────────────────────────
STORAGE_BACKEND=local
# Only when STORAGE_BACKEND=local:
LOCAL_STORAGE_PATH=/data/photos

# Only when STORAGE_BACKEND=s3 (django-storages / MinIO):
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=meter-photos
# S3_REGION_NAME=us-east-1
