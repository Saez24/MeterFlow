# Apache config for the FTP webhosting (branch `supabase`).

# Never serve the FTP-Deploy-Action state file (it lists every deployed file).
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Angular SPA: deep links like /settings are client-side routes. Serve
# index.html for every path that is not an existing file or directory.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# index.html and the service-worker files must not be cached, otherwise
# clients keep running an old build after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|ngsw\.json|ngsw-worker\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Security headers (security-standards §7). HSTS is already sent by the netcup
# front proxy — not repeated here. No per-request nonce on static hosting, so the
# build has no inline scripts (angular.json: inlineCritical false).
# CSP runs in Report-Only first: violations show in the browser console without
# blocking. Switch the header name to Content-Security-Policy once it is clean.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # script: wasm for Tesseract/heic-to, Umami tracker · worker: Tesseract (self) + heic-to (blob:)
  # connect: Supabase REST/Auth/Storage/Realtime + Umami · img: signed Supabase photo URLs + blob: previews
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://stats.your-developer.de; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://stats.your-developer.de; img-src 'self' data: blob: https://*.supabase.co; font-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
