# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
*.env
!.env.example
# Data exports contain real meter/tariff PII — never commit them.
meterflow-export-*.json

# ── Node / Angular (frontend) ─────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Angular environment config holds only apiUrl (no secrets) and is required at
# build time. A global gitignore rule (`*environments`) would exclude it, so
# re-include the directory explicitly — otherwise CI checkout misses these files
# and the production build fails to resolve `environments/environment`.
!frontend/src/environments/
!frontend/src/environments/*.ts
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/allure-results/
frontend/allure-report/

# ── Python / Django (backend) ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/.venv/
backend/staticfiles/
backend/media/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.pytest_cache/
backend/htmlcov/
backend/allure-results/
.coverage

# ── Docker / data ─────────────────────────────────────────────────────────────
# Anchored to repo root — a bare `data/` would also ignore backend/tests/data/
# (test fixtures), which broke mypy/pytest in CI (module tests.data.generator).
/data/
*.sqlite3

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
.idea/
*.log

docs/
